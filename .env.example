# Alpaca API Credentials
# Get these from: https://app.alpaca.markets/
APCA_API_KEY_ID=PK1234567890
APCA_API_SECRET_KEY=SECRET1234567890

# API Base URL (paper trading by default)
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Trading Parameters
SYMBOLS_TO_TRADE=AAPL,MSFT,GOOGL,TSLA,SPY
CHECK_INTERVAL=60
MAX_DAILY_LOSS=-5000
RISK_PER_TRADE=0.02
MIN_CONFIDENCE_THRESHOLD=0.6
Get Account

